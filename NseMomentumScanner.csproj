<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Optimize>true</Optimize>
    <AssemblyName>NseMomentumScanner</AssemblyName>
    <RootNamespace>NseMomentumScanner</RootNamespace>
    <Description>NSE Momentum Scanner · Multi-Timeframe · Production v4.1</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Program - Copy.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="scanner20260721.log" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.*" />
    <PackageReference Include="Skender.Stock.Indicators" Version="2.*" />
    <PackageReference Include="Serilog" Version="3.*" />
    <PackageReference Include="Serilog.Sinks.Console" Version="4.*" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.*" />
    <PackageReference Include="CsvHelper" Version="33.*" />
  </ItemGroup>
</Project>
